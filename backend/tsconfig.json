{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": ".",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node", "express"],

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["**/*.ts"],
  // Ignora o arquivo de configuração do prisma, as dependências e a saída do build.
  // (Ao definir "exclude", o padrão do TypeScript deixa de valer, por isso node_modules e dist
  // precisam estar listados explicitamente.)
  "exclude": ["prisma.config.ts", "node_modules", "dist"]
}
