# Copie este arquivo para backend/.env e preencha os valores. NUNCA commite o .env.

# Porta HTTP da API
PORT=3000

# URL para conexão da aplicação (Supabase — connection pooler)
DATABASE_URL=sua_url_banco

# URL para migrations do Prisma (Supabase — conexão direta ou session pooler)
DIRECT_URL=sua_url_direta

# ---------- Autenticação (JWT) ----------
# Segredo com pelo menos 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Validade do token: número + unidade (s, m, h ou d)
JWT_EXPIRES_IN=8h

# ---------- Seed (npm run db:seed) ----------
# Primeiro gestor do sistema. Usado uma única vez para permitir o primeiro login.
SEED_GESTOR_USUARIO=admin
SEED_GESTOR_SENHA=troque_esta_senha
SEED_GESTOR_NOME=Administrador
SEED_DEPARTAMENTO_NOME=Administração
