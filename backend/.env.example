# Porta para rodar a API
PORT=3000

# URL para conexão da aplicação
DATABASE_URL=sua_url_banco

# URL para migrations do Prisma
DIRECT_URL=sua_url_direta

# Segredo usado no token JWT
JWT_SECRET=seu_segredo_jwt_muito_secreto

# Tempo de expiração do token
JWT_EXPIRES_IN=8h

# Credenciais do seed
SEED_GESTOR_USUARIO="usuario_gestor"
SEED_GESTOR_SENHA="senha_gestor"
SEED_GESTOR_NOME="nome_gestor"

SEED_DEPARTAMENTO_NOME="nome_departamento"

SEED_TECNICO_USUARIO="usuario_tecnico"
SEED_TECNICO_SENHA="senha_tecnico"
SEED_TECNICO_NOME="nome_tecnico"

SEED_DEPARTAMENTO_TECNICO_NOME="nome_departamento_tecnico"