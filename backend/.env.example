# Backend SGOS — modelo de configuração local.
# Copie para .env e substitua todos os valores de exemplo.
# Nunca committe backend/.env nem compartilhe as URLs com senha.

PORT=3000

# Supabase: Connect -> Session pooler -> URI (porta 5432).
# Cole a URI disponibilizada pelo painel e mantenha a senha URL-encoded se necessário.
# Nesta configuração, a API e o Prisma CLI usam a mesma URI do Session Pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Gere um segredo aleatório com pelo menos 32 caracteres.
# Comando: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO
JWT_EXPIRES_IN=8h

# URL para criação de migrations a partir de schemas locais
SHADOW_DATABASE_URL="sua_url_shadow_database"
# Origem do frontend local (ajuste se o Vite usar outra porta).
CORS_ORIGIN=http://localhost:5173

# Supabase Storage — anexos das O.S. (US#2.6).
# Supabase: Project Settings -> Data API (Project URL) e API Keys (secret / service_role).
# A chave secreta ignora as políticas de acesso: use SOMENTE no backend, nunca no frontend.
# O bucket precisa ser PRIVADO (Storage -> New bucket -> Public bucket desmarcado).
# Sem estas variáveis a API sobe, mas as rotas de anexo respondem 503.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELA_CHAVE_SECRETA
SUPABASE_BUCKET_ANEXOS=anexos-os

# Regras dos anexos (PE-12 — valores provisórios até a decisão do cliente).
# Tipos aceitos: MIME types separados por vírgula, sem curingas. Vazio = png, jpeg, webp e pdf.
ANEXO_TIPOS_PERMITIDOS=image/png,image/jpeg,image/webp,application/pdf
# Quantidade máxima de anexos por O.S. Vazio = 10.
ANEXO_QUANTIDADE_MAXIMA=10

# Usadas apenas ao executar o seed inicial do ambiente.
# O seed não redefine senha/nome quando o usuário já existe.
SEED_GESTOR_USUARIO=usuario_gestor
SEED_GESTOR_SENHA=SUBSTITUA_POR_SENHA_FORTE
SEED_GESTOR_NOME=Gestor de teste
SEED_DEPARTAMENTO_NOME=Administracao

SEED_TECNICO_USUARIO=usuario_tecnico
SEED_TECNICO_SENHA=SUBSTITUA_POR_SENHA_FORTE
SEED_TECNICO_NOME=Tecnico de teste
SEED_DEPARTAMENTO_TECNICO_NOME=Tecnologia
