generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anexos {
  id             Int            @id @default(autoincrement())
  os_id          Int
  nome           String         @db.VarChar(255)
  tipo           String
  tamanho_bytes  BigInt
  caminho        String
  data_upload    DateTime       @default(now()) @db.Timestamptz(6)
  ordens_servico ordens_servico @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model auditoria {
  id               Int            @id @default(autoincrement())
  os_id            Int
  funcionario_id   Int
  data_modificacao DateTime       @default(now()) @db.Timestamptz(6)
  acao             tipo_auditoria
  campo_alterado   String?
  dado_antigo      String?
  dado_novo        String?
  justificativa    String?
  tipo_entidade    String         @default("ordem_servico")
  funcionarios     funcionarios   @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico   ordens_servico @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([os_id, data_modificacao], map: "idx_auditoria_os_data")
}

model clientes {
  id                  Int                   @id @default(autoincrement())
  nome                String
  razao_social        String
  ramo_atuacao        String
  locais_operacionais locais_operacionais[]
  ordens_servico      ordens_servico[]
  projetos            projetos[]
}

model departamentos {
  id                                                       Int                      @id @default(autoincrement())
  responsavel_id                                           Int?
  nome                                                     String
  funcionarios_departamentos_responsavel_idTofuncionarios  funcionarios?            @relation("departamentos_responsavel_idTofuncionarios", fields: [responsavel_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "responsavel_fk")
  funcionarios_funcionarios_departamento_idTodepartamentos funcionarios[]           @relation("funcionarios_departamento_idTodepartamentos")
  ordens_servico                                           ordens_servico[]
  projetos_departamentos                                   projetos_departamentos[]
}

model equipes {
  funcionario_id Int
  os_id          Int
  funcionarios   funcionarios   @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico ordens_servico @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([funcionario_id, os_id])
}

model funcionarios {
  id                                                         Int                 @id @default(autoincrement())
  departamento_id                                            Int
  usuario                                                    String              @unique
  senha_hash                                                 String
  nome                                                       String
  tipo                                                       tipo_perfil         @default(tecnico)
  apontamento_horas                                          apontamento_horas[]
  auditoria                                                  auditoria[]
  departamentos_departamentos_responsavel_idTofuncionarios   departamentos[]     @relation("departamentos_responsavel_idTofuncionarios")
  equipes                                                    equipes[]
  departamentos_funcionarios_departamento_idTodepartamentos  departamentos       @relation("funcionarios_departamento_idTodepartamentos", fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico_ordens_servico_responsavel_idTofuncionarios ordens_servico[]    @relation("ordens_servico_responsavel_idTofuncionarios")
  ordens_servico_ordens_servico_solicitante_idTofuncionarios ordens_servico[]    @relation("ordens_servico_solicitante_idTofuncionarios")
}

model locais_operacionais {
  id             Int                    @id @default(autoincrement())
  cliente_id     Int
  descricao      String
  tipo           tipo_local_operacional
  clientes       clientes               @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico ordens_servico[]
}

model ordens_servico {
  id                                                       Int                  @id @default(autoincrement())
  departamento_id                                          Int
  cliente_id                                               Int?
  solicitante_id                                           Int
  responsavel_id                                           Int?
  projeto_id                                               Int?
  anterior_id                                              Int?
  parecer_tecnico                                          String?
  tipo                                                     tipo_ordem_servico   @default(instalacao)
  criticidade                                              nivel_criticidade    @default(medio)
  descricao                                                String
  status                                                   status_enum          @default(em_andamento)
  data_criacao                                             DateTime             @default(now()) @db.Timestamptz(6)
  sla_config_id                                            Int?
  ativo_id                                                 Int?
  titulo                                                   String
  prazo_dias_uteis                                         Int?
  data_inicio                                              DateTime?            @db.Timestamptz(6)
  data_fim                                                 DateTime?            @db.Timestamptz(6)
  data_limite_sla                                          DateTime?            @db.Timestamptz(6)
  sla_manual                                               Boolean              @default(false)
  justificativa_sla_manual                                 String?
  anexos                                                   anexos[]
  apontamento_horas                                        apontamento_horas[]
  auditoria                                                auditoria[]
  equipes                                                  equipes[]
  ordens_servico                                           ordens_servico?      @relation("ordens_servicoToordens_servico", fields: [anterior_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_ordens_servico                                     ordens_servico[]     @relation("ordens_servicoToordens_servico")
  locais_operacionais                                      locais_operacionais? @relation(fields: [ativo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes                                                 clientes?            @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departamentos                                            departamentos        @relation(fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projetos                                                 projetos?            @relation(fields: [projeto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionarios_ordens_servico_responsavel_idTofuncionarios funcionarios?        @relation("ordens_servico_responsavel_idTofuncionarios", fields: [responsavel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sla_config                                               sla_config?          @relation(fields: [sla_config_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionarios_ordens_servico_solicitante_idTofuncionarios funcionarios         @relation("ordens_servico_solicitante_idTofuncionarios", fields: [solicitante_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([criticidade, data_limite_sla], map: "idx_os_criticidade_limite")
  @@index([departamento_id, status], map: "idx_os_departamento_status")
  @@index([projeto_id], map: "idx_os_projeto")
  @@index([responsavel_id, status], map: "idx_os_responsavel_status")
}

model projetos {
  id                     Int                      @id @default(autoincrement())
  cliente_id             Int
  data_fim               DateTime?                @db.Timestamptz(6)
  status                 status_projeto           @default(em_planejamento)
  data_inicio            DateTime?                @db.Timestamptz(6)
  ordens_servico         ordens_servico[]
  clientes               clientes                 @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projetos_departamentos projetos_departamentos[]
}

model projetos_departamentos {
  projeto_id      Int
  departamento_id Int
  departamentos   departamentos @relation(fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projetos        projetos      @relation(fields: [projeto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([projeto_id, departamento_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model apontamento_horas {
  id              Int            @id @default(autoincrement())
  funcionario_id  Int
  os_id           Int
  data_trabalho   DateTime       @db.Date
  duracao_minutos Int
  descricao       String?
  data_criacao    DateTime       @default(now()) @db.Timestamptz(6)
  funcionarios    funcionarios   @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico  ordens_servico @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([funcionario_id, data_trabalho], map: "idx_apontamentos_funcionario_data")
}

model feriados {
  id        Int      @id @default(autoincrement())
  data      DateTime @unique @db.Date
  descricao String
  nacional  Boolean  @default(false)

  @@index([data], map: "idx_feriados_data")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sla_config {
  id               Int                @id @default(autoincrement())
  tipo             tipo_ordem_servico
  criticidade      nivel_criticidade
  prazo_dias_uteis Int?
  ordens_servico   ordens_servico[]

  @@unique([tipo, criticidade], map: "config_unica")
}

enum nivel_criticidade {
  baixo
  medio
  alto
  muito_alto
  urgente
}

enum tipo_arquivo {
  png
  jpeg
  pdf
  webp
}

enum tipo_auditoria {
  insercao
  atualizacao
  exclusao
}

enum tipo_local_operacional {
  offshore
  terrestre
  site
}

enum tipo_ordem_servico {
  instalacao
  manutencao
}

enum tipo_perfil {
  gestor
  tecnico
}

enum status_enum {
  em_andamento
  aguardando
  validacao_testes
  bloqueado
  concluido
}

enum status_projeto {
  em_planejamento
  em_andamento
  pausado
  concluido
}
