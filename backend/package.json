{
  "name": "sgos-backend",
  "private": true,
  "description": "API do SGOS (GesTec / ALTAVE) — Express 5 + Prisma 7 + PostgreSQL",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.5.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch server.ts",
    "build": "tsc",
